{
  "manifest_version": 3,
  "name": "Rabbit Hole",
  "version": "2.2",
  "description": "Turns your YouTube home feed into an endless feed for any topic you choose.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Rabbit Hole" }
}
